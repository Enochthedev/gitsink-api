# Example environment variables for gitsink-api
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
GITHUB_API_BASE=https://api.github.com/repos
GITHUB_MD_URL=https://raw.githubusercontent.com
GITHUB_PERSONAL_TOKEN=your-token-here
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development
LOCAL_API_KEY=dev-key
JWT_SECRET=change-me
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
TOKEN_ENCRYPTION_KEY=change-me
WEBHOOK_USER_ID=webhook-user
