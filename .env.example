# Example environment variables for gitsink-api

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://gitsink:password@localhost:5432/gitsink_dev

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development
APP_NAME=GitSink
APP_VERSION=1.0.0

# ============================================
# Security Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
TOKEN_ENCRYPTION_KEY=your-super-secret-encryption-key-at-least-32-chars
LOCAL_API_KEY=dev-key-for-local-development-only

# ============================================
# GitHub Integration
# ============================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
GITHUB_PERSONAL_TOKEN=your-github-personal-access-token
GITHUB_API_BASE=https://api.github.com/repos
GITHUB_MD_URL=https://raw.githubusercontent.com

# ============================================
# Multi-Platform Support (Optional)
# ============================================
GITLAB_API_URL=https://gitlab.com/api/v4
BITBUCKET_API_URL=https://api.bitbucket.org

# ============================================
# Email Configuration
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# CORS and Security
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
ENABLE_HELMET=true
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# Monitoring and Observability
# ============================================
SENTRY_DSN=your-sentry-dsn-url
PROMETHEUS_ENABLED=true

# ============================================
# Webhook Configuration
# ============================================
WEBHOOK_USER_ID=webhook-system-user

# ============================================
# AI Service Configuration (Optional)
# ============================================
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=your-openai-api-key

# ============================================
# Database Configuration for Docker
# ============================================
POSTGRES_USER=gitsink
POSTGRES_PASSWORD=password
POSTGRES_DB=gitsink_dev

# ============================================
# Monitoring Configuration for Docker
# ============================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
