generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  githubId          String?             @unique
  githubToken       String?
  accessToken       String?
  apiKey            String?             @unique
  apiKeyUpdatedAt   DateTime?
  createdAt         DateTime            @default(now())
  password          String?
  resetToken        String?
  resetTokenExpires DateTime?
  username          String?             @unique
  projects          Project[]
  lastLoginAt       DateTime?
  refreshTokens     RefreshToken[]      // relation to stored refresh tokens per session
  deletedAt         DateTime?           // soft delete support
  
  // Enhanced user fields for new functionality
  tier              String              @default("free") // free, premium, enterprise
  settings          Json                @default("{}")
  profileConfig     Json                @default("{}")
  platformTokens    Json                @default("{}")
  lastSyncAt        DateTime?
  syncCount         Int                 @default(0)
  apiCallCount      Int                 @default(0)
  monthlyApiCalls   Int                 @default(0)
  lastApiCallReset  DateTime            @default(now())
  
  // Relations to new tables
  publicProfile     PublicProfile?
  platformConnections PlatformConnection[]
  syncHistory       SyncHistory[]
  auditLogs         AuditLog[]
  customMetadata    CustomMetadata[]
  apiKeyTokens      ApiKeyToken[]
  subscription      Subscription?
  
  @@index([tier])
  @@index([lastSyncAt])
  @@index([monthlyApiCalls])
}

model Project {
  id               String    @id @default(uuid())
  title            String
  description      String
  tags             String[]
  icon             String?
  image            String?
  demoUrl          String?
  repoUrl          String?
  featured         Boolean?  @default(false)
  published        Boolean?  @default(false)
  order            Int?
  category         String?
  githubSync       Boolean?  @default(true)
  blacklisted      Boolean?  @default(false)
  markdown         String?
  valid            Boolean   @default(true)
  validationErrors String[]
  collaborators    String[]
  firstCommitAt    DateTime?
  lastCommitAt     DateTime?
  githubMetadata   Json?
  customMetadata   Json?
  syncedAt         DateTime?
  ownerId          String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime? // soft delete support
  
  // Enhanced project fields
  platform         String    @default("github") // github, gitlab, bitbucket
  platformId       String?   // platform-specific repository ID
  defaultBranch    String?   @default("main")
  language         String?   // primary programming language
  languages        Json      @default("{}")  // language breakdown
  starCount        Int       @default(0)
  forkCount        Int       @default(0)
  isPrivate        Boolean   @default(false)
  license          String?
  topics           String[]  @default([])
  size             Int?      // repository size in KB
  openIssues       Int       @default(0)
  hasWiki          Boolean   @default(false)
  hasPages         Boolean   @default(false)
  archived         Boolean   @default(false)
  disabled         Boolean   @default(false)
  pushedAt         DateTime?
  
  // Relations
  owner            User         @relation(fields: [ownerId], references: [id])
  syncHistory      SyncHistory[]
  aiAnalysis       AIAnalysis[]
  customMetadataVersions CustomMetadata[]

  @@unique([ownerId, repoUrl])
  @@unique([platform, platformId])
  @@index([ownerId])
  @@index([published, featured])
  @@index([category])
  @@index([title])
  @@index([tags])
  @@index([lastCommitAt])
  @@index([platform])
  @@index([language])
  @@index([starCount])
  @@index([pushedAt])
  @@index([topics])
  @@index([isPrivate])
  @@index([archived])
}

model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique // hash of the refresh token, never store raw tokens
  expiresAt  DateTime
  deviceId   String?   // device identifier
  ipAddress  String?   // IP address when token was created
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // when token was last used for refresh
  usageCount Int       @default(0) // how many times token was used
  user       User      @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([lastUsedAt])
}

/// Stores one-time magic link tokens for email sign-in
model MagicLinkToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique   // Hash of the magic link token
  email      String             // Associated user email
  expiresAt  DateTime           // Expiration timestamp
  createdAt  DateTime @default(now())  // Creation timestamp

  @@index([email]) // look up tokens by email efficiently
}

/// Public developer profiles for showcasing projects
model PublicProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  username     String   @unique
  displayName  String?
  bio          String?
  avatar       String?
  location     String?
  website      String?
  socialLinks  Json     @default("[]")
  theme        Json     @default("{}")
  settings     Json     @default("{}")
  isPublic     Boolean  @default(false)
  customDomain String?  @unique
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([username])
  @@index([isPublic])
  @@index([customDomain])
  @@index([viewCount])
}

/// Platform connections for multi-platform repository support
model PlatformConnection {
  id               String    @id @default(uuid())
  userId           String
  platform         String    // github, gitlab, bitbucket
  platformUserId   String
  platformUsername String?
  accessToken      String?
  refreshToken     String?
  tokenExpiresAt   DateTime?
  scopes           String[]
  isActive         Boolean   @default(true)
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, platform])
  @@unique([platform, platformUserId])
  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@index([lastSyncAt])
}

/// Sync history and audit trail for repository operations
model SyncHistory {
  id            String    @id @default(uuid())
  userId        String
  projectId     String?
  operation     String    // sync, create, update, delete
  platform      String
  repositoryUrl String
  status        String    // started, completed, failed
  changes       Json      @default("[]")
  metadata      Json      @default("{}")
  error         String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  duration      Int?      // duration in milliseconds
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  @@index([userId, startedAt])
  @@index([projectId])
  @@index([status])
  @@index([platform])
  @@index([startedAt])
}

/// AI analysis results for project enrichment
model AIAnalysis {
  id         String   @id @default(uuid())
  projectId  String
  version    Int      @default(1)
  analysis   Json     // stores the complete AI analysis result
  confidence Float?   // confidence score 0.0-1.0
  model      String?  // AI model used for analysis
  createdAt  DateTime @default(now())
  
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, version])
  @@index([projectId])
  @@index([confidence])
  @@index([createdAt])
}

/// Comprehensive audit logging for security and compliance
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // login, logout, api_call, sync, etc.
  resource    String?  // resource being acted upon
  resourceId  String?  // ID of the resource
  details     Json     @default("{}")
  ipAddress   String?
  userAgent   String?
  success     Boolean  @default(true)
  error       String?
  timestamp   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId, timestamp])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
  @@index([success])
}

/// API usage tracking for rate limiting and analytics
model ApiUsage {
  id         String   @id @default(uuid())
  userId     String?
  apiKey     String?
  endpoint   String
  method     String
  statusCode Int
  duration   Int      // response time in milliseconds
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
  
  @@index([userId, timestamp])
  @@index([apiKey, timestamp])
  @@index([endpoint])
  @@index([timestamp])
  @@index([statusCode])
}

/// System health and performance metrics
model SystemMetric {
  id        String   @id @default(uuid())
  metric    String   // metric name
  value     Float    // metric value
  tags      Json     @default("{}")  // additional tags/dimensions
  timestamp DateTime @default(now())
  
  @@index([metric, timestamp])
  @@index([timestamp])
}

/// JWT token blacklist for logout functionality
model TokenBlacklist {
  id        String   @id @default(uuid())
  jti       String   @unique // JWT ID
  tokenType String   // access or refresh
  userId    String?
  reason    String?  // reason for blacklisting
  expiresAt DateTime // when the original token expires
  createdAt DateTime @default(now())
  
  @@index([jti])
  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
}

/// Webhook events for processing repository updates
model WebhookEvent {
  id                 String    @id @default(uuid())
  platform           String    // github, gitlab, bitbucket
  eventType          String    // push, pull_request, etc.
  repositoryUrl      String
  repositoryId       String
  repositoryName     String
  repositoryFullName String
  ownerId            String
  ownerName          String
  payload            Json      // complete webhook payload
  signature          String    // webhook signature for validation
  timestamp          DateTime  // when the event occurred
  processed          Boolean   @default(false)
  retryCount         Int       @default(0)
  lastRetryAt        DateTime?
  error              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  @@index([platform, eventType])
  @@index([repositoryId])
  @@index([ownerId])
  @@index([timestamp])
  @@index([processed])
  @@index([retryCount])
  @@index([platform, repositoryId, timestamp])
}

/// Custom metadata storage with versioning for Portfolio.md enhancements
model CustomMetadata {
  id         String   @id @default(uuid())
  projectId  String
  userId     String
  version    Int
  metadata   Json     // the actual custom metadata
  hash       String   // SHA-256 hash of metadata for change detection
  size       Int      // size of metadata in bytes
  fieldCount Int      // number of fields in metadata
  createdAt  DateTime @default(now())
  
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, version])
  @@index([projectId])
  @@index([userId])
  @@index([hash])
  @@index([createdAt])
}

/// Email bounce tracking for email delivery monitoring
model EmailBounce {
  id             String   @id @default(uuid())
  messageId      String
  email          String
  bounceType     String   // permanent, transient
  bounceSubType  String
  diagnosticCode String?
  feedbackId     String?
  timestamp      DateTime
  createdAt      DateTime @default(now())
  
  @@index([email])
  @@index([messageId])
  @@index([timestamp])
  @@index([bounceType])
}

/// Email complaint tracking for spam/abuse monitoring
model EmailComplaint {
  id            String   @id @default(uuid())
  messageId     String
  email         String
  complaintType String   // abuse, fraud, virus, other
  feedbackId    String?
  userAgent     String?
  timestamp     DateTime
  createdAt     DateTime @default(now())
  
  @@index([email])
  @@index([messageId])
  @@index([timestamp])
  @@index([complaintType])
}

/// Email delivery tracking for successful deliveries
model EmailDelivery {
  id                   String   @id @default(uuid())
  messageId            String
  email                String
  timestamp            DateTime
  processingTimeMillis Int?
  smtpResponse         String?
  createdAt            DateTime @default(now())
  
  @@index([email])
  @@index([messageId])
  @@index([timestamp])
}

/// Email suppression list for bounced/complained emails
model EmailSuppression {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([isActive])
}

/// Failed email jobs for retry processing
model FailedEmailJob {
  id          String    @id @default(uuid())
  email       String
  subject     String
  type        String
  data        String?   // JSON string
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([nextRetryAt, attempts])
  @@index([email])
  @@index([type])
}

/// Multiple API Keys per user for different applications/purposes
model ApiKeyToken {
  id            String    @id @default(uuid())
  userId        String
  name          String    // User-friendly name (e.g., "Production App", "Development")
  keyHash       String    @unique // SHA-256 hash of the API key (never store raw)
  keyPrefix     String    // First 8 characters for display (e.g., "gs_abc12...")
  permissions   String[]  @default(["read", "write"]) // read, write, admin
  rateLimit     Int       @default(1000) // Requests per hour
  expiresAt     DateTime? // Optional expiration
  lastUsedAt    DateTime?
  lastUsedIp    String?
  usageCount    Int       @default(0)
  isActive      Boolean   @default(true)
  environment   String    @default("production") // development, staging, production
  allowedIps    String[]  @default([]) // IP whitelist (empty = all allowed)
  allowedOrigins String[] @default([]) // CORS origins (empty = all allowed)
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  revokedAt     DateTime?
  revokedReason String?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
  @@index([isActive])
  @@index([lastUsedAt])
  @@index([environment])
  @@index([createdAt])
}

/// Subscription tiers with feature limits and pricing
model Tier {
  id            String   @id @default(uuid())
  name          String   @unique // 'free', 'pro', 'enterprise'
  displayName   String
  description   String?
  monthlyPrice  Decimal  @default(0) @db.Decimal(10, 2)
  yearlyPrice   Decimal  @default(0) @db.Decimal(10, 2)
  currency      String   @default("USD")
  
  // Limits (use -1 for unlimited)
  projectLimit      Int    @default(5)
  apiKeyLimit       Int    @default(1)
  apiCallsPerMonth  Int    @default(1000)
  syncFrequency     String @default("daily") // realtime, hourly, daily
  webhookLimit      Int    @default(1)
  teamMemberLimit   Int    @default(0)
  storageLimit      Int    @default(100) // MB
  
  // Features (boolean flags)
  aiEnrichment      Boolean @default(false)
  customDomain      Boolean @default(false)
  prioritySupport   Boolean @default(false)
  analytics         Boolean @default(false)
  exportData        Boolean @default(false)
  whiteLabel        Boolean @default(false)
  sso               Boolean @default(false)
  
  features      String[] @default([]) // Additional feature flags
  metadata      Json     @default("{}")
  isActive      Boolean  @default(true)
  isPopular     Boolean  @default(false) // Highlight in UI
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  
  // External payment provider IDs
  stripeProductId        String?
  stripePriceIdMonthly   String?
  stripePriceIdYearly    String?
  paypalPlanIdMonthly    String?
  paypalPlanIdYearly     String?
  lemonSqueezyVariantIdMonthly String?
  lemonSqueezyVariantIdYearly  String?

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
}

/// User subscriptions linking users to tiers
model Subscription {
  id                    String    @id @default(uuid())
  userId                String    @unique // One active subscription per user
  tierId                String
  status                String    @default("active") // active, canceled, past_due, trialing, paused
  billingCycle          String    @default("monthly") // monthly, yearly
  
  // Billing period
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialStart            DateTime?
  trialEnd              DateTime?
  
  // Cancellation
  cancelAtPeriodEnd     Boolean   @default(false)
  canceledAt            DateTime?
  cancelReason          String?
  
  // Payment provider info
  paymentProvider       String?   // 'stripe', 'paypal', 'lemonsqueezy', null for free
  externalSubscriptionId String?  // External subscription ID
  externalCustomerId    String?   // External customer ID
  
  // Usage tracking (reset each period)
  currentApiCalls       Int       @default(0)
  currentProjects       Int       @default(0)
  currentStorage        Int       @default(0) // MB used
  
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                  Tier      @relation(fields: [tierId], references: [id])
  payments              Payment[]

  @@index([userId])
  @@index([tierId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([paymentProvider])
}

/// Payment history and invoices
model Payment {
  id                String   @id @default(uuid())
  userId            String
  subscriptionId    String?
  
  // Amount
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("USD")
  
  // Status
  status            String   // succeeded, pending, failed, refunded, disputed
  type              String   @default("subscription") // subscription, one_time, refund
  
  // Payment provider
  paymentProvider   String   // stripe, paypal, lemonsqueezy
  externalPaymentId String?  // External payment/charge ID
  externalInvoiceId String?  // External invoice ID
  
  // URLs
  invoiceUrl        String?
  receiptUrl        String?
  hostedInvoiceUrl  String?
  
  // Details
  description       String?
  billingReason     String?  // subscription_create, subscription_cycle, subscription_update
  failureCode       String?
  failureMessage    String?
  
  // Refund info
  refundedAmount    Decimal? @db.Decimal(10, 2)
  refundedAt        DateTime?
  refundReason      String?
  
  metadata          Json     @default("{}")
  paidAt            DateTime?
  createdAt         DateTime @default(now())

  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([paymentProvider])
  @@index([createdAt])
  @@index([paidAt])
}