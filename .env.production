# Production environment variables for gitsink-api
# Copy this file and update with your production values

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://username:password@host:5432/gitsink_prod

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis-host:6379
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=production
APP_NAME=GitSink
APP_VERSION=1.0.0

# ============================================
# Security Configuration (CHANGE THESE!)
# ============================================
JWT_SECRET=your-production-jwt-secret-must-be-at-least-32-characters-long
TOKEN_ENCRYPTION_KEY=your-production-encryption-key-must-be-at-least-32-characters-long

# ============================================
# GitHub Integration
# ============================================
GITHUB_CLIENT_ID=your-production-github-client-id
GITHUB_CLIENT_SECRET=your-production-github-client-secret
GITHUB_CALLBACK_URL=https://yourdomain.com/auth/github/callback
GITHUB_PERSONAL_TOKEN=your-production-github-token
GITHUB_API_BASE=https://api.github.com/repos
GITHUB_MD_URL=https://raw.githubusercontent.com

# ============================================
# Multi-Platform Support
# ============================================
GITLAB_API_URL=https://gitlab.com/api/v4
BITBUCKET_API_URL=https://api.bitbucket.org

# ============================================
# Email Configuration
# ============================================
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# CORS and Security
# ============================================
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com
ENABLE_HELMET=true
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ============================================
# Monitoring and Observability
# ============================================
SENTRY_DSN=your-production-sentry-dsn
PROMETHEUS_ENABLED=true

# ============================================
# Webhook Configuration
# ============================================
WEBHOOK_USER_ID=production-webhook-user

# ============================================
# AI Service Configuration
# ============================================
AI_SERVICE_URL=https://your-ai-service.com
OPENAI_API_KEY=your-production-openai-key

# ============================================
# Database Configuration for Docker
# ============================================
POSTGRES_USER=gitsink_prod
POSTGRES_PASSWORD=secure-production-password
POSTGRES_DB=gitsink_prod

# ============================================
# Monitoring Configuration
# ============================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=secure-grafana-password