# Development Environment Variables
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://gitsink:password@postgres:5432/gitsink_dev
POSTGRES_USER=gitsink
POSTGRES_PASSWORD=password
POSTGRES_DB=gitsink_dev

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# GitHub Configuration
GITHUB_API_BASE=https://api.github.com/repos
GITHUB_MD_URL=https://raw.githubusercontent.com
GITHUB_PERSONAL_TOKEN=your-dev-token-here
GITHUB_CLIENT_ID=your-dev-client-id
GITHUB_CLIENT_SECRET=your-dev-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Security Configuration (Development - Use secure values in production)
JWT_SECRET=dev-jwt-secret-change-in-production
TOKEN_ENCRYPTION_KEY=dev-encryption-key-change-in-production
LOCAL_API_KEY=dev-api-key

# Email Configuration (Development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev
EMAIL_FROM=dev@gitsink.local

# Application Configuration
APP_NAME=GitSink Dev
CORS_ORIGIN=http://localhost:3000
WEBHOOK_USER_ID=dev-webhook-user

# Development Tools Configuration
PGADMIN_EMAIL=admin@gitsink.dev
PGADMIN_PASSWORD=password
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Development Performance Configuration
NODE_OPTIONS=--max-old-space-size=512