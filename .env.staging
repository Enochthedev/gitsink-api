# Staging environment variables for gitsink-api

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://gitsink_staging:password@staging-db:5432/gitsink_staging

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://staging-redis:6379
REDIS_HOST=staging-redis
REDIS_PORT=6379
REDIS_PASSWORD=staging-redis-password
REDIS_DB=0

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=staging
APP_NAME=GitSink-Staging
APP_VERSION=1.0.0

# ============================================
# Security Configuration
# ============================================
JWT_SECRET=staging-jwt-secret-at-least-32-characters-long-for-testing
TOKEN_ENCRYPTION_KEY=staging-encryption-key-at-least-32-characters-long-for-testing

# ============================================
# GitHub Integration
# ============================================
GITHUB_CLIENT_ID=staging-github-client-id
GITHUB_CLIENT_SECRET=staging-github-client-secret
GITHUB_CALLBACK_URL=https://staging.yourdomain.com/auth/github/callback
GITHUB_PERSONAL_TOKEN=staging-github-token
GITHUB_API_BASE=https://api.github.com/repos
GITHUB_MD_URL=https://raw.githubusercontent.com

# ============================================
# Multi-Platform Support
# ============================================
GITLAB_API_URL=https://gitlab.com/api/v4
BITBUCKET_API_URL=https://api.bitbucket.org

# ============================================
# Email Configuration
# ============================================
SMTP_HOST=staging-smtp-host
SMTP_PORT=587
SMTP_USER=staging-smtp-user
SMTP_PASS=staging-smtp-password
EMAIL_FROM=staging@yourdomain.com

# ============================================
# CORS and Security
# ============================================
CORS_ORIGIN=https://staging.yourdomain.com,https://staging-app.yourdomain.com
ENABLE_HELMET=true
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ============================================
# Monitoring and Observability
# ============================================
SENTRY_DSN=staging-sentry-dsn
PROMETHEUS_ENABLED=true

# ============================================
# Webhook Configuration
# ============================================
WEBHOOK_USER_ID=staging-webhook-user

# ============================================
# AI Service Configuration
# ============================================
AI_SERVICE_URL=https://staging-ai-service.com
OPENAI_API_KEY=staging-openai-key

# ============================================
# Database Configuration for Docker
# ============================================
POSTGRES_USER=gitsink_staging
POSTGRES_PASSWORD=staging-db-password
POSTGRES_DB=gitsink_staging

# ============================================
# Monitoring Configuration
# ============================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=staging-grafana-password